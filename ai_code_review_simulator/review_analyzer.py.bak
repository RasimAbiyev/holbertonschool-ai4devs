import ast
from dataclasses import dataclass


@dataclass(frozen=True)
class ReviewIssue:
    line: int
    severity: str
    rule: str
    message: str


class ReviewAnalyzer(ast.NodeVisitor):
    """Detect common Python code review issues using the AST."""

    def __init__(self):
        self.issues = []

    def add_issue(self, node, severity, rule, message):
        self.issues.append(
            ReviewIssue(
                line=getattr(node, "lineno", 1),
                severity=severity,
                rule=rule,
                message=message,
            )
        )

    def is_mutable_default(self, node):
        if isinstance(
            node,
            (
                ast.List,
                ast.Dict,
                ast.Set,
                ast.ListComp,
                ast.DictComp,
                ast.SetComp,
            ),
        ):
            return True

        if isinstance(node, ast.Tuple):
            return any(
                self.is_mutable_default(element)
                for element in node.elts
            )

        if isinstance(node, ast.Call):
            return (
                isinstance(node.func, ast.Name)
                and node.func.id in {"list", "dict", "set"}
            )

        return False

    def visit_function(self, node):
        defaults = list(node.args.defaults)

        defaults.extend(
            default
            for default in node.args.kw_defaults
            if default is not None
        )

        for default in defaults:
            if self.is_mutable_default(default):
                self.add_issue(
                    default,
                    "HIGH",
                    "MUTABLE_DEFAULT",
                    f"Function '{node.name}' uses a mutable default argument.",
                )

        self.generic_visit(node)

    def visit_FunctionDef(self, node):
        self.visit_function(node)

    def visit_AsyncFunctionDef(self, node):
        self.visit_function(node)

    def visit_ExceptHandler(self, node):
        if node.type is None:
            self.add_issue(
                node,
                "MEDIUM",
                "BARE_EXCEPT",
                "Bare except catches unexpected exceptions.",
            )

        self.generic_visit(node)

    def visit_Call(self, node):
        if isinstance(node.func, ast.Name):
            if node.func.id in {"eval", "exec"}:
                self.add_issue(
                    node,
                    "HIGH",
                    "DYNAMIC_EXECUTION",
                    f"Use of {node.func.id}() may execute unsafe code.",
                )

        self.generic_visit(node)

    def analyze(self, source, filename="<string>"):
        self.issues = []
        tree = ast.parse(source, filename=filename)
        self.visit(tree)

        return sorted(
            self.issues,
            key=lambda issue: issue.line,
        )


def review_file(path):
    with open(path, "r", encoding="utf-8") as file:
        source = file.read()

    analyzer = ReviewAnalyzer()
    return analyzer.analyze(source, filename=path)


def format_report(issues):
    if not issues:
        return "No review issues found."

    lines = [f"Found {len(issues)} issue(s):"]

    for issue in issues:
        lines.append(
            f"[{issue.severity}] Line {issue.line} "
            f"{issue.rule}: {issue.message}"
        )

    return "\n".join(lines)
